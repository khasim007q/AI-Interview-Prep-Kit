# Environment mode: development | production | test
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas connection string for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-interview-prep?retryWrites=true&w=majority

# Authentication (Secure session secret)
SESSION_SECRET=generate-a-secure-random-string-at-least-32-characters-long

# LLM Provider (Google Gemini API Key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Public Interview Research (SerpAPI Key for company interview discussions)
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_api_key_here

# Frontend URL (Used for CORS and cookie origin validation)
# Local: http://localhost:3000
# Production: https://ai-interview-prep-kit-web-zlwr.vercel.app
FRONTEND_URL=http://localhost:3000

# Security & Crawling Configuration
ALLOW_LOCAL_FETCH=true
CRAWL_MAX_PAGES=10
CRAWL_MAX_DEPTH=2
CRAWL_TIMEOUT_MS=10000
